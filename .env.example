# Shopify App Credentials (from Shopify Partner Dashboard)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# App Configuration
# Local dev: use cloudflare tunnel URL
# Railway: use your custom domain (e.g., https://sales.pandorasdeckbox.com)
APP_URL=https://your-app-url.example.com
PORT=3000
NODE_ENV=development

# Session Secret (generate a random string with: openssl rand -base64 32)
SESSION_SECRET=your_random_secret_here

# Database
# For local dev: sqlite:sessions.db (uses SQLite file)
# For Railway: set DATABASE_URL to the PostgreSQL connection string from Railway's Postgres plugin
DATABASE_URL=sqlite:sessions.db

# Scopes needed for the app
SCOPES=read_all_orders,read_products,read_inventory
